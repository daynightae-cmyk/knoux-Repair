# KNOUX REPAIR — Local OAuth configuration
# Copy this file to .env.local. Never commit .env.local or paste secrets into source files.

# Set true only after at least one provider below is configured and verified.
KNOUX_AUTH_REQUIRED=false
# The authenticated app is returned to this local Vite origin.
KNOUX_AUTH_FRONTEND_ORIGIN=http://127.0.0.1:5173

# GitHub OAuth App
# Authorization callback URL to register: http://127.0.0.1:8787/api/auth/callback/github
KNOUX_GITHUB_CLIENT_ID=
KNOUX_GITHUB_CLIENT_SECRET=

# Microsoft Entra ID app registration
# Redirect URI to register: http://127.0.0.1:8787/api/auth/callback/entra
# Keep the tenant as organizations for work/school accounts, or replace with a tenant ID.
KNOUX_ENTRA_CLIENT_ID=
KNOUX_ENTRA_TENANT_ID=organizations
# Optional for a public-client PKCE registration. If supplied, it stays in the local bridge only.
KNOUX_ENTRA_CLIENT_SECRET=
