# AI Models & Open Code Zen Configuration
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Server-side model routing. Must be a model the configured key can actually use.
GEMINI_MODEL=gemini-3.8-flash
# Fail a generate request honestly instead of hanging the UI. Range: 1000-180000.
AI_PROVIDER_TIMEOUT_MS=110000

# Copy this file to .env.local. Never commit .env.local or paste secrets into source files.

# Local authentication mode
# false = Local Mode (provider sign-in optional)
# true  = protected execution (provider session required before repair runs)
KNOUX_AUTH_REQUIRED=false
KNOUX_AUTH_FRONTEND_ORIGIN=http://127.0.0.1:3000

# Google OAuth
# Authorization callback URL: http://127.0.0.1:8787/api/auth/callback/google
GOOGLE_CLIENT_ID=
# Only set for a confidential/web client that requires it. Never expose to React.
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App
# Authorization callback URL: http://127.0.0.1:8787/api/auth/callback/github
KNOUX_GITHUB_CLIENT_ID=
KNOUX_GITHUB_CLIENT_SECRET=

# Microsoft Entra ID
# Redirect URI: http://localhost:8787/api/auth/callback/entra
KNOUX_ENTRA_CLIENT_ID=
KNOUX_ENTRA_TENANT_ID=organizations
# Optional for a public-client PKCE registration. Never expose to React.
KNOUX_ENTRA_CLIENT_SECRET=
