{
  "name": "knoux-repair-nexus",
  "private": true,
  "version": "2.0.2",
  "description": "KNOUX Repair Glass Nexus local Windows repair workstation",
  "author": "KNOUX",
  "repository": "https://github.com/daynightae-cmyk/knoux-Repair.git",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "preview": "vite preview",
    "bridge": "node server/bridge.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.460.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.knoux.repair.glassnexus",
    "productName": "KNOUX Repair Glass Nexus",
    "artifactName": "KNOUX-Repair-Glass-Nexus-Setup-${version}.${ext}",
    "directories": {
      "output": "../Release/Glass-Nexus"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "knoux-runtime/web-frontend/server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../Config",
        "to": "knoux-runtime/Config",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../Core",
        "to": "knoux-runtime/Core",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../Docs",
        "to": "knoux-runtime/Docs",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../01-System-Maintenance",
        "to": "knoux-runtime/01-System-Maintenance",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../02-System-Cleanup",
        "to": "knoux-runtime/02-System-Cleanup",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../03-Network-Internet",
        "to": "knoux-runtime/03-Network-Internet",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../04-Programs-Applications",
        "to": "knoux-runtime/04-Programs-Applications",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../05-Duplicate-Files",
        "to": "knoux-runtime/05-Duplicate-Files",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../06-Disk-Space",
        "to": "knoux-runtime/06-Disk-Space",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../07-Services-Processes",
        "to": "knoux-runtime/07-Services-Processes",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../08-Performance",
        "to": "knoux-runtime/08-Performance",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../09-Security",
        "to": "knoux-runtime/09-Security",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../10-Diagnostics-Reports",
        "to": "knoux-runtime/10-Diagnostics-Reports",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../11-Backup-Recovery",
        "to": "knoux-runtime/11-Backup-Recovery",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../12-Developer-Tools",
        "to": "knoux-runtime/12-Developer-Tools",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../13-Privacy",
        "to": "knoux-runtime/13-Privacy",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../14-Driver-Management",
        "to": "knoux-runtime/14-Driver-Management",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../15-System-Monitoring",
        "to": "knoux-runtime/15-System-Monitoring",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../16-Software-Environment",
        "to": "knoux-runtime/16-Software-Environment",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../17-PostInstall-Setup",
        "to": "knoux-runtime/17-PostInstall-Setup",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../18-Project-Sonar",
        "to": "knoux-runtime/18-Project-Sonar",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/brand/knoux-repair-logo.png",
        "to": "knoux-runtime/Assets/knoux-repair-logo.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/brand/knoux-repair-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KNOUX Repair Glass Nexus"
    }
  }
}
