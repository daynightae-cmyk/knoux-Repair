rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().userId == userId &&
        incoming().email is string &&
        incoming().email.size() <= 200;
      allow update: if isOwner(userId) &&
        incoming().userId == existing().userId;
      allow delete: if false;
    }

    // Repair Sessions
    match /repair_sessions/{sessionId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(sessionId) &&
        incoming().userId == request.auth.uid &&
        incoming().actionName is string && incoming().actionName.size() <= 200 &&
        incoming().status in ['pending', 'in_progress', 'completed', 'failed'];
      allow update: if isSignedIn() &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Diagnostic Audits
    match /diagnostic_audits/{auditId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(auditId) &&
        incoming().userId == request.auth.uid &&
        incoming().healthScore is number;
      allow update: if isSignedIn() &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Workspace Sync Events
    match /workspace_syncs/{syncId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(syncId) &&
        incoming().userId == request.auth.uid &&
        incoming().service in ['drive', 'gmail', 'sheets', 'docs', 'slides', 'tasks', 'forms', 'keep'] &&
        incoming().title is string && incoming().title.size() <= 300;
      allow update: if isSignedIn() &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
