<Application x:Class="KnouxRepair.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KnouxRepair.Converters"
             ShutdownMode="OnLastWindowClose"
             StartupUri="Views/SplashScreen.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Sizing & Spacing Tokens -->
                <ResourceDictionary Source="Themes/Variables.xaml"/>
                <!-- Theme Colors -->
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <!-- Typography -->
                <ResourceDictionary Source="Themes/Typography.xaml"/>
                <!-- Controls -->
                <ResourceDictionary Source="Themes/Controls.xaml"/>
                <!-- Animations -->
                <ResourceDictionary Source="Themes/Animations.xaml"/>
                <!-- Default language (English) -->
                <ResourceDictionary Source="Resources/Strings.en.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <local:StringEqualsFullToVisConverter x:Key="StringEqualsFullToVis"/>
            <local:RiskToBrushConverter x:Key="RiskToBrush"/>
            <local:RiskToVisibilityConverter x:Key="RiskToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
