<UserControl x:Class="KnouxRepair.Controls.ToolCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mappers="clr-namespace:KnouxRepair.Mappers"
             mc:Ignorable="d" 
             d:DesignHeight="240" d:DesignWidth="300"
             Cursor="Hand">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Border x:Name="RootBorder"
            Background="{DynamicResource CardFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1" Color="Black"/>
        </Border.Effect>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardFillColorHoverBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeHoverBrush}"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.25" Color="Black"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header - Category Icon + Risk Badge -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Category Icon -->
                <Viewbox Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Path Data="{Binding MappedCategoryIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Fill="{DynamicResource BrushCyan}"/>
                </Viewbox>
                
                <!-- Risk Badge -->
                <Border Grid.Column="1"
                        Background="{Binding RiskBackgroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        BorderBrush="{Binding RiskBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        BorderThickness="0.5"
                        CornerRadius="4"
                        Padding="6,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource FontIcon}"
                                   FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding RiskLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{Binding RiskForegroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2: Localized Service Name (Primary Title) -->
            <TextBlock Grid.Row="2"
                       Text="{Binding LocalizedName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{DynamicResource TextMainBrush}"
                       FontSize="14" FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="40"/>

            <!-- Row 4: Arabic Name (if applicable) -->
            <TextBlock Grid.Row="4"
                       Text="{Binding Tool.ArabicName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="11"
                       FlowDirection="RightToLeft"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsArabicNameVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>

            <!-- Row 6: Purpose -->
            <TextBlock Grid.Row="6"
                       Text="{Binding Tool.Purpose, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       MaxHeight="35"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Row 8: Capability Chips -->
            <ItemsControl Grid.Row="8" ItemsSource="{Binding CapabilityChips, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BrushSurface}"
                                CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                            <TextBlock Text="{Binding}" FontSize="8"
                                       Foreground="{DynamicResource BrushCyan}"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Row 10: Action Buttons -->
            <StackPanel Grid.Row="10" Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="{Binding PrimaryActionLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Command="{Binding PrimaryActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Tool, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{DynamicResource PrimaryActionButtonStyle}"
                        Padding="10,4" FontSize="11" Margin="0,0,6,0"/>
                
                <Button Content="{Binding SecondaryActionLabel1, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Command="{Binding SecondaryActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Tool, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{DynamicResource SecondaryActionButtonStyle}"
                        Padding="8,3" FontSize="10"
                        Visibility="{Binding SecondaryAction1Visible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- Row 12: Footer - Badges + ToolId -->
            <Grid Grid.Row="12" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left: Admin/Restart/Offline badges -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="{DynamicResource BrushSurface}"
                            CornerRadius="3" Padding="3,1" Margin="0,0,4,0"
                            Visibility="{Binding Tool.RequiresAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7EF;" FontFamily="{DynamicResource FontIcon}"
                                       FontSize="7" VerticalAlignment="Center" Margin="0,0,2,0"
                                       Foreground="{DynamicResource BrushAmber}"/>
                            <TextBlock Text="Admin" FontSize="7"
                                       Foreground="{DynamicResource BrushAmber}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="{DynamicResource BrushBg3}"
                            CornerRadius="3" Padding="3,1" Margin="0,0,4,0"
                            BorderThickness="0.5" BorderBrush="{DynamicResource BrushBorder}"
                            Visibility="{Binding Tool.RequiresRestart, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" FontFamily="{DynamicResource FontIcon}"
                                       FontSize="7" VerticalAlignment="Center" Margin="0,0,2,0"
                                       Foreground="{DynamicResource BrushSkyBlue}"/>
                            <TextBlock Text="Restart" FontSize="7"
                                       Foreground="{DynamicResource BrushSkyBlue}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="{DynamicResource BrushSurface}"
                            CornerRadius="3" Padding="3,1"
                            Visibility="{Binding Tool.OfflineCapability, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource StringEqualsFullToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE753;" FontFamily="{DynamicResource FontIcon}"
                                       FontSize="7" VerticalAlignment="Center" Margin="0,0,2,0"
                                       Foreground="{DynamicResource BrushGreen}"/>
                            <TextBlock Text="Offline" FontSize="7"
                                       Foreground="{DynamicResource BrushGreen}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- Right: ToolId (minor metadata) -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Tool.ToolId, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="8"
                           Foreground="{DynamicResource MutedBrush}"
                           Opacity="0.4"
                           VerticalAlignment="Bottom"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
