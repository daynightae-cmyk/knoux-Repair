<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════════════════
         KNOUX REPAIR v2.0.2 — Premium Glassmorphism Token System
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Core Palette ── -->
    <Color x:Key="BgDeepColor">#030710</Color>
    <Color x:Key="Bg1Color">#060E1A</Color>
    <Color x:Key="Bg2Color">#0A1628</Color>
    <Color x:Key="Bg3Color">#10203A</Color>
    <Color x:Key="Bg4Color">#162A48</Color>

    <!-- ── Glass Surface (semi-transparent layers) ── -->
    <Color x:Key="GlassSurfaceColor">#14FFFFFF</Color>
    <Color x:Key="GlassSurfaceHoverColor">#20FFFFFF</Color>
    <Color x:Key="GlassSurfaceActiveColor">#28FFFFFF</Color>
    <Color x:Key="GlassBorderColor">#30FFFFFF</Color>
    <Color x:Key="GlassBorderSubtleColor">#18FFFFFF</Color>

    <!-- ── Primary Accent — Cyan/Teal ── -->
    <Color x:Key="CyanColor">#00E5FF</Color>
    <Color x:Key="CyanBrightColor">#40F0FF</Color>
    <Color x:Key="CyanDeepColor">#0097A7</Color>
    <Color x:Key="CyanGlowColor">#6600E5FF</Color>

    <!-- ── Secondary Accent — Royal Blue ── -->
    <Color x:Key="RoyalBlueColor">#448AFF</Color>
    <Color x:Key="RoyalBlueBrightColor">#82B1FF</Color>
    <Color x:Key="RoyalBlueDeepColor">#2962FF</Color>
    <Color x:Key="RoyalBlueGlowColor">#44448AFF</Color>

    <!-- ── Tertiary — Sky ── -->
    <Color x:Key="SkyBlueColor">#80D8FF</Color>
    <Color x:Key="SkyBlueGlowColor">#3380D8FF</Color>

    <!-- ── Semantic Colors ── -->
    <Color x:Key="GreenColor">#00E676</Color>
    <Color x:Key="GreenBrightColor">#69F0AE</Color>
    <Color x:Key="GreenGlowColor">#4400E676</Color>
    <Color x:Key="AmberColor">#FFD740</Color>
    <Color x:Key="AmberBrightColor">#FFE57F</Color>
    <Color x:Key="AmberGlowColor">#44FFD740</Color>
    <Color x:Key="RedColor">#FF5252</Color>
    <Color x:Key="RedBrightColor">#FF8A80</Color>
    <Color x:Key="RedGlowColor">#44FF5252</Color>
    <Color x:Key="GoldColor">#D4AF37</Color>

    <!-- ── Text Colors ── -->
    <Color x:Key="TextMainColor">#F5F9FF</Color>
    <Color x:Key="TextSecondaryColor">#B0BEC5</Color>
    <Color x:Key="MutedColor">#607D8B</Color>
    <Color x:Key="TextDimColor">#37474F</Color>

    <!-- ── Semantic Backgrounds ── -->
    <Color x:Key="DangerBgColor">#22FF5252</Color>
    <Color x:Key="SuccessBgColor">#2200E676</Color>
    <Color x:Key="WarningBgColor">#22FFD740</Color>
    <Color x:Key="InfoBgColor">#2200E5FF</Color>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SOLID BRUSHES
         ═══════════════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeepColor}"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1Color}"/>
    <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2Color}"/>
    <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3Color}"/>
    <SolidColorBrush x:Key="Bg4Brush" Color="{StaticResource Bg4Color}"/>

    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}"/>
    <SolidColorBrush x:Key="CyanBrightBrush" Color="{StaticResource CyanBrightColor}"/>
    <SolidColorBrush x:Key="CyanDeepBrush" Color="{StaticResource CyanDeepColor}"/>
    <SolidColorBrush x:Key="RoyalBlueBrush" Color="{StaticResource RoyalBlueColor}"/>
    <SolidColorBrush x:Key="RoyalBlueBrightBrush" Color="{StaticResource RoyalBlueBrightColor}"/>
    <SolidColorBrush x:Key="SkyBlueBrush" Color="{StaticResource SkyBlueColor}"/>

    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="GreenBrightBrush" Color="{StaticResource GreenBrightColor}"/>
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}"/>
    <SolidColorBrush x:Key="AmberBrightBrush" Color="{StaticResource AmberBrightColor}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}"/>
    <SolidColorBrush x:Key="RedBrightBrush" Color="{StaticResource RedBrightColor}"/>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>

    <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMainColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>

    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="{StaticResource GlassSurfaceColor}"/>
    <SolidColorBrush x:Key="GlassSurfaceHoverBrush" Color="{StaticResource GlassSurfaceHoverColor}"/>
    <SolidColorBrush x:Key="GlassSurfaceActiveBrush" Color="{StaticResource GlassSurfaceActiveColor}"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}"/>
    <SolidColorBrush x:Key="GlassBorderSubtleBrush" Color="{StaticResource GlassBorderSubtleColor}"/>

    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource InfoBgColor}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════
         GRADIENT BRUSHES
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Title bar: subtle top-down glass gradient -->
    <LinearGradientBrush x:Key="TitleBarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#18FFFFFF" Offset="0"/>
        <GradientStop Color="#08FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Sidebar: left-to-right subtle depth -->
    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#12FFFFFF" Offset="0"/>
        <GradientStop Color="#06FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Hero panel: radial teal glow -->
    <RadialGradientBrush x:Key="HeroGlowBrush" GradientOrigin="0.3,0.4" Center="0.5,0.5"
                         RadiusX="0.6" RadiusY="0.5">
        <GradientStop Color="#1800E5FF" Offset="0"/>
        <GradientStop Color="#0800E5FF" Offset="0.5"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>

    <!-- Accent gradient for buttons -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF00BCD4" Offset="0"/>
        <GradientStop Color="#FF0097A7" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF26C6DA" Offset="0"/>
        <GradientStop Color="#FF00ACC1" Offset="1"/>
    </LinearGradientBrush>

    <!-- Royal blue gradient -->
    <LinearGradientBrush x:Key="RoyalBlueGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF448AFF" Offset="0"/>
        <GradientStop Color="#FF2962FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Health gradient: green -->
    <LinearGradientBrush x:Key="HealthGreenGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF00E676" Offset="0"/>
        <GradientStop Color="#FF69F0AE" Offset="1"/>
    </LinearGradientBrush>

    <!-- Health gradient: amber -->
    <LinearGradientBrush x:Key="HealthAmberGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFD740" Offset="0"/>
        <GradientStop Color="#FFFFE57F" Offset="1"/>
    </LinearGradientBrush>

    <!-- Health gradient: red -->
    <LinearGradientBrush x:Key="HealthRedGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFF5252" Offset="0"/>
        <GradientStop Color="#FFFF8A80" Offset="1"/>
    </LinearGradientBrush>

    <!-- Health gradient: cyan (CPU) -->
    <LinearGradientBrush x:Key="HealthCyanGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF00E5FF" Offset="0"/>
        <GradientStop Color="#FF80D8FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Health gradient: blue (Disk) -->
    <LinearGradientBrush x:Key="HealthBlueGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF448AFF" Offset="0"/>
        <GradientStop Color="#FF82B1FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Card glass gradient -->
    <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#10FFFFFF" Offset="0"/>
        <GradientStop Color="#06FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradientHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1CFFFFFF" Offset="0"/>
        <GradientStop Color="#0EFFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Status bar gradient -->
    <LinearGradientBrush x:Key="StatusBarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0CFFFFFF" Offset="0"/>
        <GradientStop Color="#04FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Splash ring gradient -->
    <LinearGradientBrush x:Key="SplashRingGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF00E5FF" Offset="0"/>
        <GradientStop Color="#FF448AFF" Offset="0.5"/>
        <GradientStop Color="#FF00E676" Offset="1"/>
    </LinearGradientBrush>

    <!-- Danger gradient -->
    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF5252" Offset="0"/>
        <GradientStop Color="#FFD32F2F" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══════════════════════════════════════════════════════════════════════
         GLOW EFFECTS (DropShadow used as glow via Color + low BlurRadius)
         ═══════════════════════════════════════════════════════════════════════ -->
    <DropShadowEffect x:Key="CyanGlow" BlurRadius="20" ShadowDepth="0"
                      Opacity="0.35" Color="#00E5FF"/>
    <DropShadowEffect x:Key="CyanGlowStrong" BlurRadius="30" ShadowDepth="0"
                      Opacity="0.5" Color="#00E5FF"/>
    <DropShadowEffect x:Key="GreenGlow" BlurRadius="16" ShadowDepth="0"
                      Opacity="0.3" Color="#00E676"/>
    <DropShadowEffect x:Key="AmberGlow" BlurRadius="16" ShadowDepth="0"
                      Opacity="0.3" Color="#FFD740"/>
    <DropShadowEffect x:Key="RedGlow" BlurRadius="16" ShadowDepth="0"
                      Opacity="0.3" Color="#FF5252"/>
    <DropShadowEffect x:Key="BlueGlow" BlurRadius="16" ShadowDepth="0"
                      Opacity="0.3" Color="#448AFF"/>
    <DropShadowEffect x:Key="WindowShadow" BlurRadius="40" ShadowDepth="0"
                      Opacity="0.5" Color="Black"/>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2"
                      Opacity="0.25" Color="Black"/>
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="24" ShadowDepth="4"
                      Opacity="0.4" Color="Black"/>

    <!-- ═══════════════════════════════════════════════════════════════════════
         NAVIGATION VIEW TOKENS
         ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="NavigationViewDefaultColor">#00000000</Color>
    <Color x:Key="NavigationViewPointerOverColor">#14FFFFFF</Color>
    <Color x:Key="NavigationViewPressedColor">#18FFFFFF</Color>
    <Color x:Key="NavigationViewSelectedColor">#1800E5FF</Color>
    <Color x:Key="NavigationViewIndicatorColor">#00E5FF</Color>

    <SolidColorBrush x:Key="NavigationViewDefaultBrush" Color="{StaticResource NavigationViewDefaultColor}"/>
    <SolidColorBrush x:Key="NavigationViewPointerOverBrush" Color="{StaticResource NavigationViewPointerOverColor}"/>
    <SolidColorBrush x:Key="NavigationViewPressedBrush" Color="{StaticResource NavigationViewPressedColor}"/>
    <SolidColorBrush x:Key="NavigationViewSelectedBrush" Color="{StaticResource NavigationViewSelectedColor}"/>
    <SolidColorBrush x:Key="NavigationViewIndicatorBrush" Color="{StaticResource NavigationViewIndicatorColor}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════
         DATAGRID TOKENS
         ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="DataGridHeaderBgColor">#12FFFFFF</Color>
    <Color x:Key="DataGridRowHoverColor">#0CFFFFFF</Color>
    <Color x:Key="DataGridRowSelectedColor">#1800E5FF</Color>
    <Color x:Key="DataGridBorderColor">#12FFFFFF</Color>

    <SolidColorBrush x:Key="DataGridHeaderBgBrush" Color="{StaticResource DataGridHeaderBgColor}"/>
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="{StaticResource DataGridRowHoverColor}"/>
    <SolidColorBrush x:Key="DataGridRowSelectedBrush" Color="{StaticResource DataGridRowSelectedColor}"/>
    <SolidColorBrush x:Key="DataGridBorderBrush" Color="{StaticResource DataGridBorderColor}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════
         INPUT CONTROL TOKENS (ComboBox, TextBox defaults)
         ═══════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="InputBgColor">#0CFFFFFF</Color>
    <Color x:Key="InputBgHoverColor">#14FFFFFF</Color>
    <Color x:Key="InputBgFocusedColor">#18FFFFFF</Color>
    <Color x:Key="InputBorderColor">#22FFFFFF</Color>
    <Color x:Key="InputBorderFocusedColor">#5000E5FF</Color>

    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="InputBgHoverBrush" Color="{StaticResource InputBgHoverColor}"/>
    <SolidColorBrush x:Key="InputBgFocusedBrush" Color="{StaticResource InputBgFocusedColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="InputBorderFocusedBrush" Color="{StaticResource InputBorderFocusedColor}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════
         DynamicResource ALIASES (used by Views — must remain for compat)
         ═══════════════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="BrushBg1" Color="{StaticResource Bg1Color}"/>
    <SolidColorBrush x:Key="BrushBg2" Color="{StaticResource Bg2Color}"/>
    <SolidColorBrush x:Key="BrushBg3" Color="{StaticResource Bg3Color}"/>
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource GlassSurfaceColor}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource GlassBorderColor}"/>
    <SolidColorBrush x:Key="BrushCyan" Color="{StaticResource CyanColor}"/>
    <SolidColorBrush x:Key="BrushRoyalBlue" Color="{StaticResource RoyalBlueColor}"/>
    <SolidColorBrush x:Key="BrushSkyBlue" Color="{StaticResource SkyBlueColor}"/>
    <SolidColorBrush x:Key="BrushGold" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="BrushGreen" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="BrushAmber" Color="{StaticResource AmberColor}"/>
    <SolidColorBrush x:Key="BrushAmberDim" Color="#55FFD740"/>
    <SolidColorBrush x:Key="BrushRed" Color="{StaticResource RedColor}"/>
    <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="BrushTextMain" Color="{StaticResource TextMainColor}"/>
    <SolidColorBrush x:Key="BrushDangerBg" Color="{StaticResource DangerBgColor}"/>
    <SolidColorBrush x:Key="BrushSuccessBg" Color="{StaticResource SuccessBgColor}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════
         FLUENT SEMANTIC TOKENS (inspired by WPF UI)
         These provide standardized naming for control-level coloring.
         Existing tokens above remain for backward compatibility.
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Surface / Layer Colors -->
    <Color x:Key="LayerFillColorDefaultColor">#4C3A3A3A</Color>
    <Color x:Key="CardFillColorDefaultColor">#0DFFFFFF</Color>
    <Color x:Key="CardStrokeDefaultColor">#19000000</Color>
    <Color x:Key="ControlFillColorDefaultColor">#0FFFFFFF</Color>
    <Color x:Key="ControlStrokeDefaultColor">#12FFFFFF</Color>
    <Color x:Key="DividerStrokeDefaultColor">#15FFFFFF</Color>

    <!-- Text Fill (Fluent naming) -->
    <Color x:Key="TextFillColorPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextFillColorSecondaryColor">#C5FFFFFF</Color>
    <Color x:Key="TextFillColorTertiaryColor">#87FFFFFF</Color>
    <Color x:Key="TextFillColorDisabledColor">#5DFFFFFF</Color>

    <!-- System Semantic Fills -->
    <Color x:Key="SystemFillColorSuccessColor">#6CCB5F</Color>
    <Color x:Key="SystemFillColorCautionColor">#FCE100</Color>
    <Color x:Key="SystemFillColorCriticalColor">#FF99A4</Color>
    <Color x:Key="SystemFillColorAttentionColor">#4CC2FF</Color>

    <!-- Fluent Brushes -->
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource LayerFillColorDefaultColor}"/>
    <SolidColorBrush x:Key="CardFillColorDefaultBrush" Color="{StaticResource CardFillColorDefaultColor}"/>
    <SolidColorBrush x:Key="CardStrokeDefaultBrush" Color="{StaticResource CardStrokeDefaultColor}"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource ControlFillColorDefaultColor}"/>
    <SolidColorBrush x:Key="ControlStrokeDefaultBrush" Color="{StaticResource ControlStrokeDefaultColor}"/>
    <SolidColorBrush x:Key="DividerStrokeDefaultBrush" Color="{StaticResource DividerStrokeDefaultColor}"/>

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextFillColorPrimaryColor}"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextFillColorSecondaryColor}"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextFillColorTertiaryColor}"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource TextFillColorDisabledColor}"/>

    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{StaticResource SystemFillColorSuccessColor}"/>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{StaticResource SystemFillColorCautionColor}"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{StaticResource SystemFillColorCriticalColor}"/>
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{StaticResource SystemFillColorAttentionColor}"/>

    <!-- Elevation Shadows (Fluent-inspired, 4 levels) -->
    <DropShadowEffect x:Key="Elevation2" BlurRadius="4" ShadowDepth="1" Opacity="0.15" Color="Black"/>
    <DropShadowEffect x:Key="Elevation4" BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="Black"/>
    <DropShadowEffect x:Key="Elevation8" BlurRadius="16" ShadowDepth="4" Opacity="0.25" Color="Black"/>
    <DropShadowEffect x:Key="Elevation16" BlurRadius="24" ShadowDepth="8" Opacity="0.3" Color="Black"/>

</ResourceDictionary>
