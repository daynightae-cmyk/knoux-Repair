<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <FontFamily x:Key="PrimaryFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Courier New</FontFamily>

    <!-- Alias fonts for DynamicResource -->
    <FontFamily x:Key="FontDisplay">Segoe UI</FontFamily>
    <FontFamily x:Key="FontBody">Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono,Consolas,Courier New</FontFamily>
    <FontFamily x:Key="FontIcon">Segoe MDL2 Assets</FontFamily>

    <FontWeight x:Key="LightWeight">Light</FontWeight>
    <FontWeight x:Key="RegularWeight">Regular</FontWeight>
    <FontWeight x:Key="SemiBoldWeight">SemiBold</FontWeight>
    <FontWeight x:Key="BoldWeight">Bold</FontWeight>

    <sys:Double x:Key="SizeXS">10</sys:Double>
    <sys:Double x:Key="SizeS">11</sys:Double>
    <sys:Double x:Key="SizeM">13</sys:Double>
    <sys:Double x:Key="SizeL">15</sys:Double>
    <sys:Double x:Key="SizeXL">18</sys:Double>
    <sys:Double x:Key="SizeXXL">24</sys:Double>
    <sys:Double x:Key="SizeXXXL">32</sys:Double>
    <sys:Double x:Key="SizeDisplay">40</sys:Double>

    <!-- ═══════════════════════════════════════════════════════════════════════
         NAMED TEXTBLOCK STYLES (Fluent-inspired)
         Provides consistent typography hierarchy across all views.
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Caption: 12px Regular — labels, metadata, timestamps -->
    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- Body: 14px Regular — default body text -->
    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
    </Style>

    <!-- Body Strong: 14px SemiBold — emphasized body -->
    <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
    </Style>

    <!-- Subtitle: 18px SemiBold — section subtitles -->
    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
    </Style>

    <!-- Title: 24px SemiBold — page titles -->
    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
    </Style>

    <!-- Title Large: 32px SemiBold — hero titles -->
    <Style x:Key="TitleLargeTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
    </Style>

    <!-- Mono Label: 11px Cascadia Mono — IDs, technical labels -->
    <Style x:Key="MonoLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>

    <!-- Navigation Section Header: 9.5px Bold uppercase — sidebar group labels -->
    <Style x:Key="NavSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Margin" Value="14,10,14,5"/>
    </Style>

    <!-- Page Section Header: 15px SemiBold — section titles within pages -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
    </Style>

    <!-- Card Value: 24px Bold — large metric numbers -->
    <Style x:Key="CardValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Card Label: 10.5px Regular — card labels -->
    <Style x:Key="CardLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>

</ResourceDictionary>
