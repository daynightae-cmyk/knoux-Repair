                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="0"
                                                      Opacity="0.45" Color="#FF5252"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="glowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="30" ShadowDepth="0"
                                                      Opacity="0.55" Color="#FF5252"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
