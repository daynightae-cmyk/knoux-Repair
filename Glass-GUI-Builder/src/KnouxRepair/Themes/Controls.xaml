        </Setter>
    </Style>

    <!-- ── Glass TextBox ── -->
    <Style x:Key="GlassTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#0CFFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="{StaticResource SizeM}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="glowHost" Background="Transparent" CornerRadius="8">
                        <Border x:Name="border"
                                Background="#0CFFFFFF"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="2">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#6000E5FF"/>
                            <Setter TargetName="glowHost" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                      Opacity="0.2" Color="#00E5FF"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#40FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Toggle Switch ── -->
    <Style x:Key="GlassToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" CornerRadius="11"
                                Background="{DynamicResource BrushBg3}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1" Width="42" Height="22">
                            <Border x:Name="Thumb" CornerRadius="8"
                                    Width="16" Height="16"
                                    HorizontalAlignment="Left"
                                    Margin="3,0,0,0"
                                    Background="{DynamicResource BrushMuted}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1"
                                                      Opacity="0.3" Color="Black"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF00BCD4" Offset="0"/>
                                        <GradientStop Color="#FF0097A7" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#6000E5FF"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            <Setter TargetName="Thumb" Property="Background" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Window minimize/maximize button ── -->
    <Style x:Key="WindowButton" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontIcon}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="6" Margin="2,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#18FFFFFF"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushTextMain}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#28FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Window close button (red hover) ── -->
    <Style x:Key="WindowButtonClose" TargetType="Button" BasedOn="{StaticResource WindowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="Transparent"
                            CornerRadius="6" Margin="2,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFE81919"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFD32F2F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Navigation sidebar radio button ── -->
    <Style x:Key="NavRadioButton" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="Nav"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <!-- Active indicator bar -->
                        <Border x:Name="indicator" Width="3" HorizontalAlignment="Left"
                                CornerRadius="2" Margin="0,6,0,6"
                                Background="{DynamicResource BrushCyan}" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0"
                                                  Opacity="0.5" Color="#00E5FF"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="border" Background="Transparent"
                                CornerRadius="8" Margin="4,1">
                            <Border x:Name="innerBorder" Background="Transparent"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="content" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="innerBorder" Property="Background" Value="#14FFFFFF"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="innerBorder" Property="Background" Value="#1800E5FF"/>
                            <Setter Property="Foreground" Value="{DynamicResource BrushCyan}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="indicator" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Status Badge ── -->
    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Background" Value="{DynamicResource InfoBgBrush}"/>
    </Style>

