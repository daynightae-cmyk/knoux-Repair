<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════════════════
         KNOUX REPAIR — Fluent Sizing, Spacing & Layout Tokens
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Corner Radii -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PopupCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="WindowCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="DataGridRowCornerRadius">4</CornerRadius>

    <!-- Control Sizing -->
    <sys:Double x:Key="ControlMinHeight">36</sys:Double>
    <sys:Double x:Key="ControlMinHeightSmall">28</sys:Double>
    <sys:Double x:Key="ControlMinHeightLarge">44</sys:Double>
    <sys:Double x:Key="NavigationViewItemMinHeight">36</sys:Double>
    <sys:Double x:Key="ListViewItemMinHeight">34</sys:Double>
    <sys:Double x:Key="DataGridRowMinHeight">34</sys:Double>
    <sys:Double x:Key="DataGridColumnHeaderHeight">36</sys:Double>

    <!-- Layout Sizing -->
    <sys:Double x:Key="TitleBarHeight">40</sys:Double>
    <sys:Double x:Key="StatusBarHeight">32</sys:Double>
    <sys:Double x:Key="NavWidth">220</sys:Double>
    <sys:Double x:Key="ConsolePanelHeight">200</sys:Double>

    <!-- Padding -->
    <Thickness x:Key="ControlPadding">14,8</Thickness>
    <Thickness x:Key="CardPadding">16,18</Thickness>
    <Thickness x:Key="SectionPadding">20</Thickness>
    <Thickness x:Key="PageMargin">0,0,28,28</Thickness>
    <Thickness x:Key="NavItemPadding">14,10</Thickness>

    <!-- Border Widths -->
    <sys:Double x:Key="BorderWidthDefault">1</sys:Double>
    <sys:Double x:Key="BorderWidthFocused">2</sys:Double>

    <!-- Animation Durations -->
    <sys:Double x:Key="DurationFast">120</sys:Double>
    <sys:Double x:Key="DurationNormal">200</sys:Double>
    <sys:Double x:Key="DurationSlow">350</sys:Double>

</ResourceDictionary>
