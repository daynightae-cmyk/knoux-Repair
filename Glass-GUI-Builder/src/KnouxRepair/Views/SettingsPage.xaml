<UserControl x:Class="KnouxRepair.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,24,24" MaxWidth="640">
            <TextBlock Text="{DynamicResource SettingsTitle}"
                       Style="{DynamicResource TitleTextBlockStyle}"/>
            <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Margin="0,4,0,24"/>

            <!-- ===== APPEARANCE ===== -->
            <Border Style="{DynamicResource FluentCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SettingsAppearance}"
                               Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,16"/>

                    <!-- Language -->
                    <TextBlock Text="{DynamicResource SettingsLanguage}"
                               Style="{DynamicResource BodyStrongTextBlockStyle}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton x:Name="EnglishLanguageRadio" Content="{DynamicResource SettingsLanguageEnglish}" GroupName="Lang"
                                     Style="{DynamicResource NavRadioButton}" Margin="0,0,8,0"
                                     Click="LangEnglish_Click"/>
                        <RadioButton x:Name="ArabicLanguageRadio" Content="{DynamicResource SettingsLanguageArabic}" GroupName="Lang"
                                     Style="{DynamicResource NavRadioButton}"
                                     Click="LangArabic_Click"/>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource SettingsTheme}" Style="{DynamicResource BodyStrongTextBlockStyle}" Margin="0,14,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="DarkThemeRadio" Content="{DynamicResource ThemeDark}" GroupName="Theme" IsChecked="True" Style="{DynamicResource NavRadioButton}" Margin="0,0,8,0" Click="ThemeDark_Click"/>
                        <RadioButton x:Name="LightThemeRadio" Content="{DynamicResource ThemeLight}" GroupName="Theme" Style="{DynamicResource NavRadioButton}" Click="ThemeLight_Click"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource DividerStrokeDefaultBrush}" Margin="0,14"/>

                    <!-- Reduced Motion -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsReducedMotion}"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{DynamicResource SettingsReducedMotionDescription}"
                                       Style="{DynamicResource CaptionTextBlockStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="ReducedMotionToggle" Grid.Column="1"
                                      Style="{DynamicResource GlassToggle}"
                                      Click="ReducedMotion_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== APPLICATION ===== -->
            <Border Style="{DynamicResource FluentCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SettingsApplication}"
                               Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,16"/>

                    <!-- Analyze Only Default -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsAnalyzeDefault}"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{DynamicResource SettingsAnalyzeDefaultDescription}"
                                       Style="{DynamicResource CaptionTextBlockStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="AnalyzeToggle" Grid.Column="1"
                                      IsChecked="True"
                                      Style="{DynamicResource GlassToggle}"
                                      Click="AnalyzeToggle_Click"/>
                    </Grid><Border Height="1" Background="{DynamicResource DividerStrokeDefaultBrush}" Margin="0,14"/>

                    <!-- Max Report History -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsMaxReportHistory}"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{DynamicResource SettingsMaxReportHistoryDescription}"
                                       Style="{DynamicResource CaptionTextBlockStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="MaxReportsLabel" Grid.Column="1"
                                   Text="200"
                                   Foreground="{DynamicResource BrushCyan}"
                                   FontSize="14" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Grid><Border Height="1" Background="{DynamicResource DividerStrokeDefaultBrush}" Margin="0,14"/>

                    <!-- Open Project Folder -->
                    <Button Content="{DynamicResource SettingsOpenProjectFolder}"
                            Style="{DynamicResource GlassButton}"
                            Click="OpenProjectFolder_Click"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- ===== DIAGNOSTICS ===== -->
            <Border Style="{DynamicResource FluentCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SettingsDiagnostics}"
                               Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,16"/>

                    <!-- Console Font Size -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SettingsConsoleFontSize}"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{DynamicResource SettingsConsoleFontSizeDescription}"
                                       Style="{DynamicResource CaptionTextBlockStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="&#xE738;" FontFamily="{DynamicResource FontIcon}"
                                    Style="{DynamicResource GlassButton}" Width="32" Height="32"
                                    FontSize="10" Click="FontSizeDecrease_Click"/>
                            <TextBlock x:Name="FontSizeLabel" Text="13"
                                       Foreground="{DynamicResource TextMainBrush}"
                                       FontSize="12" Width="30" TextAlignment="Center"
                                       VerticalAlignment="Center" Margin="4,0"/>
                            <Button Content="&#xE710;" FontFamily="{DynamicResource FontIcon}"
                                    Style="{DynamicResource GlassButton}" Width="32" Height="32"
                                    FontSize="10" Click="FontSizeIncrease_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
