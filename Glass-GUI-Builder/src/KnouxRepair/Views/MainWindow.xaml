<Window x:Class="KnouxRepair.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource AppTitle}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource BgDeepBrush}"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Display"
        ResizeMode="CanResize"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="14"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" CornerRadius="14"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Border.Background>
            <SolidColorBrush x:Name="RootBg" Color="#FF060E1A"/>
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush x:Name="RootBorderBrush" Color="#30FFFFFF"/>
        </Border.BorderBrush>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- ===== TITLE BAR ===== -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource GlassBorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#20FFFFFF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <!-- Logo glow dot -->
                        <Grid Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse Width="22" Height="22" Opacity="0.2" Fill="{DynamicResource BrushCyan}"/>
                            <Ellipse Width="12" Height="12" Fill="{DynamicResource BrushCyan}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="KNOUX" Foreground="{DynamicResource BrushCyan}"
                                   FontFamily="{DynamicResource FontDisplay}" FontSize="14"
                                   FontWeight="Bold" VerticalAlignment="Center"
                                   Margin="0,0,3,0"/>
                        <TextBlock Text="{DynamicResource AppTitleSuffix}"
                                   Foreground="{DynamicResource BrushTextMain}"
                                   FontFamily="{DynamicResource FontDisplay}" FontSize="14"
                                   VerticalAlignment="Center" Opacity="0.8"/>
                        <Border x:Name="AdminBadge" VerticalAlignment="Center"
                                Margin="12,0,0,0" Padding="6,2"
                                CornerRadius="4" BorderThickness="1"
                                BorderBrush="#40FFD740">
                            <Border.Background>
                                <SolidColorBrush Color="#18FFD740"/>
                            </Border.Background>
                            <TextBlock x:Name="AdminBadgeText" Text="ADMINISTRATOR"
                                       Foreground="{DynamicResource BrushAmber}"
                                       FontSize="8.5" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Window buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnNotifications" Content="&#xEA8F;"
                                Style="{DynamicResource WindowButton}"
                                Click="BtnNotifications_Click"
                                ToolTip="{DynamicResource ActionNotifications}"/>
                        <Button x:Name="BtnMinimize" Content="&#xE921;"
                                Style="{DynamicResource WindowButton}"
                                Click="BtnMinimize_Click"
                                ToolTip="{DynamicResource ActionMinimize}"/>
                        <Button x:Name="BtnMaximize" Content="&#xE922;"
                                Style="{DynamicResource WindowButton}"
                                Click="BtnMaximize_Click"
                                ToolTip="{DynamicResource ActionMaximize}"/>
                        <Button x:Name="BtnClose" Content="&#xE106;"
                                Style="{DynamicResource WindowButtonClose}"
                                Click="BtnClose_Click"
                                ToolTip="{DynamicResource ActionClose}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== BODY ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavColumn" Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar Navigation -->
                <Border Grid.Column="0"
                        BorderBrush="{DynamicResource GlassBorderSubtleBrush}"
                        BorderThickness="0,0,1,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="#06FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Search Box -->
                        <Border Grid.Row="0" Background="#0CFFFFFF"
                                CornerRadius="8" Padding="10,7">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.08" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <TextBlock Text="&#xE721;" FontFamily="{DynamicResource FontIcon}"
                                           Foreground="{DynamicResource BrushMuted}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBox x:Name="SearchBox"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource BrushTextMain}"
                                         FontSize="12.5" Padding="20,0,0,0"
                                         CaretBrush="{DynamicResource BrushCyan}"
                                         TextChanged="SearchBox_TextChanged">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Grid>
                                                            <TextBlock x:Name="Placeholder"
                                                                       Text="{DynamicResource SearchPlaceholder}"
                                                                       Foreground="{DynamicResource BrushMuted}"
                                                                       FontSize="12.5"
                                                                       VerticalAlignment="Center"
                                                                       IsHitTestVisible="False"
                                                                       Visibility="Collapsed"/>
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter TargetName="Placeholder"
                                                                        Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </Border>

                        <!-- Nav Items -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="NavItems">
                                <!-- DASHBOARD section -->
                                <TextBlock Text="{DynamicResource NavSectionDashboard}"
                                           Style="{DynamicResource NavSectionHeaderStyle}"/>
                                <RadioButton x:Name="NavDashboard" Style="{DynamicResource NavRadioButton}"
                                             Tag="Dashboard" IsChecked="True"
                                             Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;" FontFamily="{DynamicResource FontIcon}"
                                                   FontSize="14" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource NavDashboard}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- REPAIR section -->
                                <TextBlock Text="{DynamicResource NavSectionRepair}"
                                           Style="{DynamicResource NavSectionHeaderStyle}"/>
                                <RadioButton x:Name="NavAllTools" Style="{DynamicResource NavRadioButton}"
                                             Tag="AllTools" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74C;" FontFamily="{DynamicResource FontIcon}"
                                                   FontSize="14" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource NavAllTools}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- MANAGEMENT section -->
                                <TextBlock Text="{DynamicResource NavSectionManagement}"
                                           Style="{DynamicResource NavSectionHeaderStyle}"/>
                                <RadioButton x:Name="NavReports" Style="{DynamicResource NavRadioButton}"
                                             Tag="Reports" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A1;" FontFamily="{DynamicResource FontIcon}"
                                                   FontSize="14" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource NavReports}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavQuarantine" Style="{DynamicResource NavRadioButton}"
                                             Tag="Quarantine" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource FontIcon}"
                                                   FontSize="14" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource NavQuarantine}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavBackups" Style="{DynamicResource NavRadioButton}"
                                             Tag="Backups" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C7;" FontFamily="{DynamicResource FontIcon}"
                                                   FontSize="14" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource NavBackups}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavTestCenter" Style="{DynamicResource NavRadioButton}"
                                             Tag="TestCenter" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource FontIcon}"
                                                   FontSize="14" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource NavTestCenter}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <!-- SYSTEM section -->
                                <TextBlock Text="{DynamicResource NavSectionSystem}"
                                           Style="{DynamicResource NavSectionHeaderStyle}"/>
                                <RadioButton x:Name="NavSettings" Style="{DynamicResource NavRadioButton}"
                                             Tag="Settings" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="{DynamicResource FontIcon}"
                                                   FontSize="14" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource NavSettings}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavAbout" Style="{DynamicResource NavRadioButton}"
                                             Tag="About" Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" FontFamily="{DynamicResource FontIcon}"
                                                   FontSize="14" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="{DynamicResource NavAbout}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Analyze-only toggle -->
                        <Border Grid.Row="3" Background="#0CFFFFFF"
                                CornerRadius="8" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource ToolAnalyzeOnly}"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="11.5" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="AnalyzeToggle" Grid.Column="1"
                                              IsChecked="{Binding AnalyzeOnlyDefault}"
                                              Style="{DynamicResource GlassToggle}"
                                              Click="AnalyzeToggle_Click"/>
                            </Grid>
                        </Border>

                        <!-- Analyze status -->
                        <TextBlock x:Name="AnalyzeStatusText" Grid.Row="4"
                                   Text="{DynamicResource AnalyzeOnlyOn}"
                                   Foreground="{DynamicResource BrushCyan}"
                                   FontSize="10" HorizontalAlignment="Center" Opacity="0.8"/>

                        <!-- Language toggle -->
                        <Button Grid.Row="5" x:Name="LangToggle"
                                Content="{DynamicResource LangToggle}"
                                Style="{DynamicResource GlassButton}"
                                Click="LangToggle_Click"
                                HorizontalAlignment="Stretch"
                                MinHeight="34" Padding="12,6" FontSize="11.5"/>

                        <!-- Version label -->
                        <TextBlock Grid.Row="7" Text="v2.0.2"
                                   Foreground="{DynamicResource BrushMuted}"
                                   FontSize="9" HorizontalAlignment="Center" Opacity="0.4"/>
                    </Grid>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" Width="1"
                              HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="Transparent"/>

                <!-- Content Area -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Subtle top glow line -->
                    <Border Grid.Row="0" Height="1" VerticalAlignment="Top"
                            Opacity="0.15" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#00E5FF" Offset="0.3"/>
                                <GradientStop Color="#00E5FF" Offset="0.7"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Page Content -->
                    <ContentControl x:Name="PageContent" Grid.Row="0" Margin="0"/>

                    <!-- Console Panel (bottom, toggleable) -->
                    <Border x:Name="ConsolePanel" Grid.Row="1"
                            Background="#F00A1628"
                            BorderBrush="{DynamicResource GlassBorderSubtleBrush}"
                            BorderThickness="0,1,0,0"
                            Height="200" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.15" Color="Black"/>
                        </Border.Effect>
                        <Grid FlowDirection="LeftToRight">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource GlassBorderSubtleBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid Margin="12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushCyan}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource ConsoleTitle}"
                                                   Foreground="{DynamicResource BrushCyan}"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" x:Name="ConsoleScroller"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ConsoleOutput"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontFamily="{DynamicResource FontMono}"
                                           FontSize="12" TextWrapping="Wrap"
                                           Margin="12,4,12,4"/>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,0,12,0">
                                <TextBlock x:Name="ConsoleMetaText" Text="{DynamicResource StatusIdle}"
                                           Foreground="{DynamicResource BrushMuted}"
                                           FontSize="10" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <Button Content="{DynamicResource ActionStop}"
                                        x:Name="BtnStopTool"
                                        Style="{DynamicResource DangerButton}"
                                        Click="BtnStopTool_Click" Visibility="Collapsed"
                                        MinHeight="26" Padding="12,4" FontSize="11"/>
                                <Button Content="{DynamicResource ActionClose}"
                                        Style="{DynamicResource GlassButton}"
                                        Margin="6,0,0,0"
                                        Click="BtnCloseConsole_Click"
                                        MinHeight="26" Padding="12,4" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Console toggle button -->
                    <Button x:Name="BtnToggleConsole" Grid.Row="1"
                            Content="&#xE74C;" FontFamily="{DynamicResource FontIcon}"
                            Style="{DynamicResource GlassButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,14,10" Width="30" Height="30"
                            FontSize="11"
                            Click="BtnToggleConsole_Click"
                            ToolTip="{DynamicResource ConsoleTitle}"/>

                    <!-- Toast overlay -->
                    <Border x:Name="ToastHost" Grid.Row="0"
                            Background="#F00E1E36"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="14,12" MaxWidth="340"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,14,14,0"
                            Visibility="Collapsed" IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4"
                                              Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ToastTransform" X="40"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="ToastDot" Grid.Column="0" Width="8" Height="8"
                                     VerticalAlignment="Top" Margin="2,5,0,0"
                                     Fill="{DynamicResource BrushCyan}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0"
                                                      Opacity="0.5" Color="#00E5FF"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="ToastTitleText"
                                           Foreground="{DynamicResource BrushTextMain}"
                                           FontSize="12" FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="ToastMessageText"
                                           Foreground="{DynamicResource BrushMuted}"
                                           FontSize="11" Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== STATUS BAR ===== -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource GlassBorderSubtleBrush}"
                    BorderThickness="0,1,0,0" Padding="14,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#10FFFFFF" Offset="0"/>
                        <GradientStop Color="#06FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource BrushGreen}" Margin="0,0,8,0" Opacity="0.7"/>
                        <TextBlock x:Name="StatusText"
                                   Text="{DynamicResource StatusReady}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="ToolCountText" Grid.Column="2"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <TextBlock x:Name="ProjectPathText" Grid.Column="3"
                               Text="{DynamicResource AppCredit}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" VerticalAlignment="Center" Opacity="0.6"/>
                </Grid>
            </Border>

            <!-- Notifications popup -->
            <Popup x:Name="NotificationsPopup" PlacementTarget="{Binding ElementName=BtnNotifications}"
                   Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
                <Border Background="#F00E1E36"
                        BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="1" CornerRadius="10"
                        Width="380" MaxHeight="440"
                        Margin="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="4"
                                          Opacity="0.5" Color="Black"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource GlassBorderSubtleBrush}"
                                BorderThickness="0,0,0,1" Padding="0,12,0,10" Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource ActionNotifications}"
                                       Foreground="{DynamicResource BrushTextMain}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Margin="14,0,14,0"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="NotificationList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0CFFFFFF"
                                                CornerRadius="8" Padding="12,10" Margin="8,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="7" Height="7"
                                                         Margin="2,5,0,0"
                                                         VerticalAlignment="Top">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource BrushCyan}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                                    <Setter Property="Fill" Value="{DynamicResource BrushGreen}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                    <Setter Property="Fill" Value="{DynamicResource BrushAmber}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                    <Setter Property="Fill" Value="{DynamicResource BrushRed}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel Grid.Column="2">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{DynamicResource BrushTextMain}"
                                                                   FontSize="11.5" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding TimeLabel}"
                                                                   Foreground="{DynamicResource BrushMuted}"
                                                                   FontSize="9.5"
                                                                   HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Message}"
                                                               Foreground="{DynamicResource BrushMuted}"
                                                               FontSize="10.5" Margin="0,3,0,0"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
