<UserControl x:Class="KnouxRepair.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KnouxRepair.ViewModels"
             Background="Transparent">
    <UserControl.Resources>
        <vm:DashboardViewModel x:Key="VM"/>
        <!-- Premium health bar style with gradient fill -->
        <Style x:Key="HealthBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0"
                                                          Opacity="0.35" Color="#00E5FF"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Standard metric card style -->
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>
        <!-- Health gauge card style -->
        <Style x:Key="GaugeCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== HERO: System Health Overview ===== -->
            <Border Grid.Row="0" CornerRadius="14" Padding="0" ClipToBounds="True"
                    BorderThickness="1" BorderBrush="{DynamicResource CardStrokeDefaultBrush}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF0A1628" Offset="0"/>
                        <GradientStop Color="#FF0D1E36" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Subtle radial glow overlay -->
                    <Border Opacity="0.3" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush GradientOrigin="0.2,0.4" Center="0.4,0.5"
                                                 RadiusX="0.5" RadiusY="0.6">
                                <GradientStop Color="#1200E5FF" Offset="0"/>
                                <GradientStop Color="#0600E5FF" Offset="0.5"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="32,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Health identity + status -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource DashTitle}"
                                   Style="{DynamicResource TitleLargeTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <!-- Health dot with glow -->
                            <Grid Width="14" Height="14" Margin="0,0,10,0"
                                  VerticalAlignment="Center">
                                <Ellipse Width="14" Height="14" Opacity="0.25"
                                         Fill="{DynamicResource BrushGreen}"/>
                                <Ellipse x:Name="HealthDot" Width="8" Height="8"
                                         Fill="{DynamicResource BrushGreen}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="HealthLabel" Text="{DynamicResource DashHealthHealthy}"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}"
                                       Foreground="{DynamicResource BrushGreen}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="HealthDesc" Text="{DynamicResource DashHealthNormalDesc}"
                                   Style="{DynamicResource CaptionTextBlockStyle}"
                                   Margin="0,4,0,0"/>

                        <!-- Primary actions row -->
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Content="{DynamicResource DashRunCheck}"
                                    Style="{DynamicResource AccentButton}"
                                    Click="BtnRunSystemCheck_Click"
                                    MinWidth="170" Padding="22,11" Margin="0,0,12,0"/>
                            <Button Content="{DynamicResource DashAnalyzeSystem}"
                                    Style="{DynamicResource GlassButton}"
                                    Click="BtnAnalyzeSystem_Click"
                                    MinWidth="170" Padding="22,11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Uptime + Admin badge -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top"
                                HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource SysUptime}"
                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding UptimeLabel}" x:Name="UptimeText"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}"
                                       FontSize="11"
                                       FlowDirection="LeftToRight"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="AdminHealthBadge" CornerRadius="4" Padding="10,5"
                                HorizontalAlignment="Right" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#22FF5252"/>
                                    <Setter Property="BorderBrush" Value="#44FF5252"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdmin, Mode=OneWay}" Value="True">
                                            <Setter Property="Background" Value="#2200E676"/>
                                            <Setter Property="BorderBrush" Value="#4400E676"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="10" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource AdminStandard}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushRed}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdmin, Mode=OneWay}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource AdminElevated}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource BrushGreen}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
                </Grid>
            </Border>

            <!-- ===== HEALTH GAUGES: CPU / RAM / DISK ===== -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="{DynamicResource DashHealthTitle}"
                           Style="{DynamicResource SectionHeaderStyle}"
                           Margin="0,0,0,12"/>
                <WrapPanel>
                    <!-- CPU -->
                    <Border Style="{DynamicResource GaugeCard}"
                            Width="290" Margin="0,0,14,14"
                            Effect="{DynamicResource Elevation2}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8"
                                         Fill="{DynamicResource BrushCyan}" Margin="0,0,10,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0"
                                                          Opacity="0.35" Color="#00E5FF"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Text="{DynamicResource HealthCpu}"
                                           Style="{DynamicResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CpuPercent, StringFormat={}{0:0}%, Mode=OneWay}"
                                           Foreground="{DynamicResource BrushCyan}"
                                           FontSize="15" FontWeight="Bold"
                                           FlowDirection="LeftToRight"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Value="{Binding CpuPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                         Style="{DynamicResource HealthBarStyle}" Margin="0,12,0,0"
                                         FlowDirection="LeftToRight">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF00E5FF" Offset="0"/>
                                        <GradientStop Color="#FF80D8FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </StackPanel>
                    </Border>
                    <!-- RAM -->
                    <Border Style="{DynamicResource GaugeCard}"
                            Width="290" Margin="0,0,14,14"
                            Effect="{DynamicResource Elevation2}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8"
                                         Fill="{DynamicResource BrushGreen}" Margin="0,0,10,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0"
                                                          Opacity="0.35" Color="#00E676"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Text="{DynamicResource HealthRam}"
                                           Style="{DynamicResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding RamPercent, StringFormat={}{0:0}%, Mode=OneWay}"
                                           Foreground="{DynamicResource BrushGreen}"
                                           FontSize="15" FontWeight="Bold"
                                           FlowDirection="LeftToRight"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Value="{Binding RamPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                         Style="{DynamicResource HealthBarStyle}" Margin="0,12,0,0"
                                         FlowDirection="LeftToRight">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF00E676" Offset="0"/>
                                        <GradientStop Color="#FF69F0AE" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                            <TextBlock Text="{Binding RamLabel}"
                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                       Margin="0,7,0,0"
                                       FlowDirection="LeftToRight"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <!-- DISK -->
                    <Border Style="{DynamicResource GaugeCard}"
                            Width="290" Margin="0,0,14,14"
                            Effect="{DynamicResource Elevation2}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8"
                                         Fill="{DynamicResource BrushRoyalBlue}" Margin="0,0,10,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0"
                                                          Opacity="0.35" Color="#448AFF"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Text="{DynamicResource HealthDisk}"
                                           Style="{DynamicResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding DiskPercent, StringFormat={}{0:0}%, Mode=OneWay}"
                                           Foreground="{DynamicResource BrushRoyalBlue}"
                                           FontSize="15" FontWeight="Bold"
                                           FlowDirection="LeftToRight"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Value="{Binding DiskPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                         Style="{DynamicResource HealthBarStyle}" Margin="0,12,0,0"
                                         FlowDirection="LeftToRight">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF448AFF" Offset="0"/>
                                        <GradientStop Color="#FF82B1FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                            <TextBlock Text="{Binding DiskLabel}"
                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                       Margin="0,7,0,0"
                                       FlowDirection="LeftToRight"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>

            <!-- ===== QUICK ACTIONS ===== -->
            <StackPanel Grid.Row="4">
                <TextBlock Text="{DynamicResource NavSectionRepair}"
                           Style="{DynamicResource SectionHeaderStyle}"
                           Margin="0,0,0,12"/>
                <WrapPanel>
                    <Button Content="{DynamicResource DashQuickMaintenance}"
                            Style="{DynamicResource GlassButton}" Click="BtnQuickMaintenance_Click"
                            MinWidth="140" Padding="18,11" Margin="0,0,10,10"/>
                    <Button Content="{DynamicResource DashQuickCleanup}"
                            Style="{DynamicResource GlassButton}" Click="BtnQuickCleanup_Click"
                            MinWidth="140" Padding="18,11" Margin="0,0,10,10"/>
                    <Button Content="{DynamicResource DashQuickNetwork}"
                            Style="{DynamicResource GlassButton}" Click="BtnQuickNetwork_Click"
                            MinWidth="140" Padding="18,11" Margin="0,0,10,10"/>
                    <Button Content="{DynamicResource DashQuickSecurity}"
                            Style="{DynamicResource GlassButton}" Click="BtnQuickSecurity_Click"
                            MinWidth="140" Padding="18,11" Margin="0,0,10,10"/>
                    <Button Content="{DynamicResource DashQuickPerformance}"
                            Style="{DynamicResource GlassButton}" Click="BtnQuickPerformance_Click"
                            MinWidth="140" Padding="18,11" Margin="0,0,10,10"/>
                    <Button Content="{DynamicResource DashQuickDisk}"
                            Style="{DynamicResource GlassButton}" Click="BtnQuickDisk_Click"
                            MinWidth="140" Padding="18,11" Margin="0,0,10,10"/>
                    <Button Content="{DynamicResource DashQuickDiagnostics}"
                            Style="{DynamicResource GlassButton}" Click="BtnQuickDiagnostics_Click"
                            MinWidth="140" Padding="18,11" Margin="0,0,10,10"/>
                </WrapPanel>
            </StackPanel>

            <!-- ===== METRIC CARDS ===== -->
            <StackPanel Grid.Row="6">
                <TextBlock Text="{DynamicResource NavSectionManagement}"
                           Style="{DynamicResource SectionHeaderStyle}"
                           Margin="0,0,0,12"/>
                <WrapPanel>
                    <!-- Total Tools -->
                    <Border Style="{DynamicResource MetricCard}"
                            Margin="0,0,14,14" MinWidth="150"
                            Effect="{DynamicResource Elevation2}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource MetricTotalTools}"
                                       Style="{DynamicResource CardLabelStyle}"/>
                            <TextBlock Text="{Binding TotalTools}"
                                       Foreground="{DynamicResource BrushCyan}"
                                       Style="{DynamicResource CardValueStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Safe Tools -->
                    <Border Style="{DynamicResource MetricCard}"
                            Margin="0,0,14,14" MinWidth="150"
                            Effect="{DynamicResource Elevation2}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource MetricSafeTools}"
                                       Style="{DynamicResource CardLabelStyle}"/>
                            <TextBlock Text="{Binding SafeTools}"
                                       Foreground="{DynamicResource BrushGreen}"
                                       Style="{DynamicResource CardValueStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Admin Tools -->
                    <Border Style="{DynamicResource MetricCard}"
                            Margin="0,0,14,14" MinWidth="150"
                            Effect="{DynamicResource Elevation2}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource MetricAdminTools}"
                                       Style="{DynamicResource CardLabelStyle}"/>
                            <TextBlock Text="{Binding AdminTools}"
                                       Foreground="{DynamicResource BrushAmber}"
                                       Style="{DynamicResource CardValueStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Reports -->
                    <Border Style="{DynamicResource MetricCard}"
                            Margin="0,0,14,14" MinWidth="150"
                            Effect="{DynamicResource Elevation2}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource MetricReports}"
                                       Style="{DynamicResource CardLabelStyle}"/>
                            <TextBlock Text="{Binding ReportCount}"
                                       Foreground="{DynamicResource BrushRoyalBlue}"
                                       Style="{DynamicResource CardValueStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Read Only -->
                    <Border Style="{DynamicResource MetricCard}"
                            Margin="0,0,14,14" MinWidth="150"
                            Effect="{DynamicResource Elevation2}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource MetricReadOnly}"
                                       Style="{DynamicResource CardLabelStyle}"/>
                            <TextBlock Text="{Binding ReadOnlyTools}"
                                       Foreground="{DynamicResource BrushGreen}"
                                       Style="{DynamicResource CardValueStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Destructive -->
                    <Border Style="{DynamicResource MetricCard}"
                            Margin="0,0,14,14" MinWidth="150"
                            Effect="{DynamicResource Elevation2}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource MetricDestructive}"
                                       Style="{DynamicResource CardLabelStyle}"/>
                            <TextBlock Text="{Binding DestructiveTools}"
                                       Foreground="{DynamicResource BrushRed}"
                                       Style="{DynamicResource CardValueStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Reboot Required -->
                    <Border Style="{DynamicResource MetricCard}"
                            Margin="0,0,14,14" MinWidth="150"
                            Effect="{DynamicResource Elevation2}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource MetricRebootRequired}"
                                       Style="{DynamicResource CardLabelStyle}"/>
                            <TextBlock Text="{Binding RebootRequiredTools}"
                                       Foreground="{DynamicResource BrushAmber}"
                                       Style="{DynamicResource CardValueStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>

            <!-- ===== CATEGORY BREAKDOWN ===== -->
            <StackPanel Grid.Row="8">
                <TextBlock Text="{DynamicResource WorkAllTools}"
                           Style="{DynamicResource SectionHeaderStyle}"
                           Margin="0,0,0,12"/>
                <ItemsControl ItemsSource="{Binding CategoryStats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource MetricCard}"
                                    Width="190" Margin="0,0,14,14"
                                    Effect="{DynamicResource Elevation2}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{DynamicResource BodyStrongTextBlockStyle}"
                                               FontSize="13.5"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Border Background="{DynamicResource SuccessBgBrush}"
                                                CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Foreground="{DynamicResource BrushGreen}"
                                                       FontSize="11">
                                                <Run Text="{Binding Safe, Mode=OneWay}"/><Run Text=" safe"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Background="{DynamicResource DangerBgBrush}"
                                                CornerRadius="4" Padding="8,3">
                                            <TextBlock Foreground="{DynamicResource BrushRed}"
                                                       FontSize="11">
                                                <Run Text="{Binding Risky, Mode=OneWay}"/><Run Text=" risky"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                               Margin="0,7,0,0">
                                        <Run Text="{Binding Total, Mode=OneWay}"/><Run Text=" tools"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== RECENT ACTIVITY ===== -->
            <Border Grid.Row="10" Style="{DynamicResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource DashRecentActivity}"
                               Style="{DynamicResource SectionHeaderStyle}"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="RecentActivityText"
                               Text="{DynamicResource DashNoActivity}"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
