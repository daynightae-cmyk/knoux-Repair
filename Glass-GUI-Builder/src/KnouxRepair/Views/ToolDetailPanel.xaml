<UserControl x:Class="KnouxRepair.Views.ToolDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="0,40,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Placeholder when no tool selected -->
        <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock Text="&#xE74B;" FontFamily="{DynamicResource FontIcon}"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="36" HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource ToolSelectTool}"
                       Style="{DynamicResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="{DynamicResource ToolSelectHint}"
                       Style="{DynamicResource CaptionTextBlockStyle}"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Tool detail content (visible when tool selected) -->
        <ScrollViewer x:Name="DetailContent" VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <StackPanel>
                <!-- Tool name + ID -->
                <Grid>
                    <StackPanel>
                        <TextBlock FontSize="10" Foreground="{DynamicResource BrushCyan}"
                                   FontWeight="Bold" x:Name="ToolIdText"/>
                        <TextBlock FontSize="17" Foreground="{DynamicResource TextMainBrush}"
                                   FontWeight="Bold" Margin="0,4,0,0"
                                   x:Name="ToolNameText"
                                   FontFamily="{DynamicResource FontDisplay}"/>
                    </StackPanel>
                </Grid>

                <!-- Badges row -->
                <WrapPanel Margin="0,12,0,0">
                    <Border x:Name="RiskBadge" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource FontIcon}"
                                       FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="RiskText" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="AdminBadge" Background="{DynamicResource BrushSurface}"
                            CornerRadius="4" Padding="6,3" Margin="0,0,6,6"
                            BorderThickness="0.5" BorderBrush="{DynamicResource BrushAmberDim}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7EF;" FontFamily="{DynamicResource FontIcon}"
                                       FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{DynamicResource ToolAdmin}"
                                       FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushAmber}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="RestartBadge" Background="{DynamicResource BrushBg3}"
                            CornerRadius="4" Padding="6,3" Margin="0,0,6,6"
                            BorderThickness="0.5" BorderBrush="{DynamicResource BrushBorder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" FontFamily="{DynamicResource FontIcon}"
                                       FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{DynamicResource ToolRestart}"
                                       FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushSkyBlue}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Purpose -->
                <TextBlock x:Name="PurposeText" FontSize="12"
                           Foreground="{DynamicResource TextMainBrush}"
                           TextWrapping="Wrap" Margin="0,14,0,0"/>

                <!-- Metadata grid -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Offline"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold" Width="110"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OfflineText"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               FontSize="11.5" Foreground="{DynamicResource TextMainBrush}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource ToolBackup}"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BackupText"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               FontSize="11.5" Foreground="{DynamicResource TextMainBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource ToolRollback}"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RollbackText"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               FontSize="11.5" Foreground="{DynamicResource TextMainBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="WhatIf"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="WhatIfText"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               FontSize="11.5" Foreground="{DynamicResource TextMainBrush}"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource ToolPath}"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" x:Name="PathText"
                               Foreground="{DynamicResource BrushCyan}" FontSize="11"
                               FontFamily="{DynamicResource FontMono}"
                               FlowDirection="LeftToRight"
                               TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Action buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnAnalyze" Content="{DynamicResource ActionAnalyzeSafely}"
                    Style="{DynamicResource AccentButton}"
                    Click="BtnAnalyze_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnRun" Content="{DynamicResource ActionRunTool}"
                    Style="{DynamicResource DangerButton}"
                    Click="BtnRun_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
