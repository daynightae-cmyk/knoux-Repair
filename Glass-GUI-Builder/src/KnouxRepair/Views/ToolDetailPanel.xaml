<UserControl x:Class="KnouxRepair.Views.ToolDetailPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" Background="Transparent">
<Grid Margin="0,40,24,24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Select a tool" Style="{DynamicResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/><TextBlock Text="Preview its real contract and available actions" Style="{DynamicResource CaptionTextBlockStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
<ScrollViewer x:Name="DetailContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock x:Name="CategoryText" Foreground="{DynamicResource BrushCyan}" FontWeight="Bold" FontSize="10"/><TextBlock x:Name="ToolNameText" Foreground="{DynamicResource TextMainBrush}" FontSize="19" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock x:Name="ToolIdText" Foreground="{DynamicResource MutedBrush}" FontFamily="{DynamicResource FontMono}" FontSize="9" Margin="0,2,0,0"/>
<WrapPanel Margin="0,12,0,0"><Border x:Name="RiskBadge" CornerRadius="4" Padding="6,3" Margin="0,0,6,6"><TextBlock x:Name="RiskText" FontSize="10.5" FontWeight="SemiBold"/></Border><Border x:Name="AdminBadge" Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="6,3" Margin="0,0,6,6"><TextBlock Text="Administrator" Foreground="{DynamicResource BrushAmber}" FontSize="10.5"/></Border><Border x:Name="RestartBadge" Background="{DynamicResource BrushSurface}" CornerRadius="4" Padding="6,3" Margin="0,0,6,6"><TextBlock Text="Restart required" Foreground="{DynamicResource BrushSkyBlue}" FontSize="10.5"/></Border></WrapPanel>
<TextBlock Text="Purpose" Style="{DynamicResource CaptionTextBlockStyle}" FontWeight="SemiBold" Margin="0,10,0,2"/><TextBlock x:Name="PurposeText" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap"/>
<TextBlock Text="Capabilities" Style="{DynamicResource CaptionTextBlockStyle}" FontWeight="SemiBold" Margin="0,14,0,2"/><ItemsControl x:Name="CapabilitiesList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource BrushSurface}" CornerRadius="3" Padding="5,3" Margin="0,0,5,5"><TextBlock Text="{Binding}" Foreground="{DynamicResource BrushCyan}" FontSize="9"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="Preview contract" Style="{DynamicResource CaptionTextBlockStyle}" FontWeight="SemiBold" Margin="0,12,0,2"/><TextBlock x:Name="PreviewText" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap"/>
<TextBlock Text="Script parameters" Style="{DynamicResource CaptionTextBlockStyle}" FontWeight="SemiBold" Margin="0,10,0,2"/><TextBlock x:Name="ParametersText" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap"/>
<TextBlock Text="Preserved / backup" Style="{DynamicResource CaptionTextBlockStyle}" FontWeight="SemiBold" Margin="0,10,0,2"/><TextBlock x:Name="BackupText" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap"/>
<TextBlock Text="Recovery / rollback" Style="{DynamicResource CaptionTextBlockStyle}" FontWeight="SemiBold" Margin="0,10,0,2"/><TextBlock x:Name="RollbackText" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap"/>
<TextBlock Text="Expected output" Style="{DynamicResource CaptionTextBlockStyle}" FontWeight="SemiBold" Margin="0,10,0,2"/><TextBlock x:Name="ExpectedText" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap"/>
<TextBlock Text="Last execution evidence" Style="{DynamicResource CaptionTextBlockStyle}" FontWeight="SemiBold" Margin="0,14,0,2"/><TextBlock x:Name="EvidenceText" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap"/>
<TextBlock Text="Script path" Style="{DynamicResource CaptionTextBlockStyle}" FontWeight="SemiBold" Margin="0,12,0,2"/><TextBlock x:Name="PathText" Foreground="{DynamicResource BrushCyan}" FontFamily="{DynamicResource FontMono}" FontSize="10" TextWrapping="Wrap"/>
</StackPanel></ScrollViewer>
<StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock x:Name="SelectionLabel" Visibility="Collapsed" Style="{DynamicResource CaptionTextBlockStyle}" Margin="0,0,0,4"/><TextBox x:Name="SelectionBox" Visibility="Collapsed" ToolTip="Enter the exact value for the script Selection parameter" automation:AutomationProperties.Name="Tool selection" Margin="0,0,0,8" Padding="8"/><WrapPanel x:Name="ActionBar"/></StackPanel></Grid></UserControl>
