<UserControl x:Class="KnouxRepair.Views.QuarantinePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="0,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource NavQuarantine}"
                       Style="{DynamicResource TitleTextBlockStyle}"/>
            <TextBlock Text="{DynamicResource QuarantineSubtitle}"
                       Style="{DynamicResource CaptionTextBlockStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{DynamicResource ActionRefresh}"
                    Style="{DynamicResource GlassButton}"
                    Click="BtnRefresh_Click" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource ActionRestoreSelected}"
                    x:Name="BtnRestore"
                    Style="{DynamicResource AccentButton}"
                    Click="BtnRestore_Click" IsEnabled="False"/>
            <Button Content="{DynamicResource ActionOpenFolder}"
                    x:Name="BtnOpenFolder"
                    Style="{DynamicResource GlassButton}"
                    Margin="8,0,0,0"
                    Click="BtnOpenFolder_Click" IsEnabled="False"/>
        </StackPanel>

        <DataGrid x:Name="QuarantineGrid" Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  Background="{DynamicResource BrushBg2}"
                  Foreground="{DynamicResource BrushTextMain}"
                  BorderBrush="{DynamicResource BrushBorder}"
                  BorderThickness="1"
                  RowBackground="{DynamicResource BrushBg2}"
                  AlternatingRowBackground="{DynamicResource BrushBg3}"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  FontSize="12"
                  SelectionChanged="QuarantineGrid_SelectionChanged">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource BrushBg3}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource QuarantineColItem}" Binding="{Binding OriginalName}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource QuarantineColTool}" Binding="{Binding ToolId}" Width="90"/>
                <DataGridTextColumn Header="{DynamicResource QuarantineColType}" Binding="{Binding ItemType}" Width="90"/>
                <DataGridTextColumn Header="{DynamicResource QuarantineColSize}" Binding="{Binding OriginalSize}" Width="90"/>
                <DataGridTextColumn Header="{DynamicResource QuarantineColOrigin}" Binding="{Binding OriginalPath}" Width="220"/>
                <DataGridTextColumn Header="{DynamicResource QuarantineColDate}" Binding="{Binding QuarantinedAt}" Width="140"/>
                <DataGridTextColumn Header="{DynamicResource QuarantineColState}" Binding="{Binding TransactionState}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>