<Window x:Class="KnouxRepair.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KNOUX Repair"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="760" Height="520"
        MinWidth="540" MinHeight="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="RootGrid" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.98" ScaleY="0.98"/>
        </Grid.RenderTransform>
        <Border x:Name="ShellBorder" CornerRadius="26" BorderThickness="1"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                Background="{DynamicResource BgDeepBrush}" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="42" ShadowDepth="0" Opacity="0.42" Color="#001A33"/>
            </Border.Effect>
            <Grid>
                <Rectangle IsHitTestVisible="False" Opacity="0.72">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.37" GradientOrigin="0.5,0.37" RadiusX="0.68" RadiusY="0.66">
                            <GradientStop Color="#4618A8E8" Offset="0"/>
                            <GradientStop Color="#180057B8" Offset="0.34"/>
                            <GradientStop Color="#00D4AF37" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False" Opacity="0.48">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#12D4AF37" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.38"/>
                            <GradientStop Color="#0E18A8E8" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Canvas IsHitTestVisible="False" Opacity="0.85">
                    <Ellipse x:Name="ParticleOne" Canvas.Left="106" Canvas.Top="108" Width="3" Height="3" Fill="#8CFFFFFF"/>
                    <Ellipse x:Name="ParticleTwo" Canvas.Left="182" Canvas.Top="212" Width="2" Height="2" Fill="#68D4AF37"/>
                    <Ellipse x:Name="ParticleThree" Canvas.Left="606" Canvas.Top="98" Width="3" Height="3" Fill="#8018A8E8"/>
                    <Ellipse x:Name="ParticleFour" Canvas.Left="644" Canvas.Top="286" Width="2" Height="2" Fill="#66FFFFFF"/>
                    <Ellipse x:Name="ParticleFive" Canvas.Left="90" Canvas.Top="360" Width="2" Height="2" Fill="#6C18A8E8"/>
                    <Ellipse x:Name="ParticleSix" Canvas.Left="572" Canvas.Top="380" Width="3" Height="3" Fill="#68D4AF37"/>
                    <Ellipse x:Name="ParticleSeven" Canvas.Left="138" Canvas.Top="60" Width="2" Height="2" Fill="#60FFFFFF"/>
                    <Ellipse x:Name="ParticleEight" Canvas.Left="690" Canvas.Top="166" Width="2" Height="2" Fill="#62D4AF37"/>
                </Canvas>

                <Grid Margin="52,34,52,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="330" Height="330">
                        <Ellipse x:Name="LogoAura" Width="276" Height="276" Opacity="0.18">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#7218A8E8" Offset="0"/>
                                    <GradientStop Color="#24D4AF37" Offset="0.56"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="36" ShadowDepth="0" Opacity="0.55" Color="#18A8E8"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <Canvas x:Name="RingEntrance" Width="286" Height="286" RenderTransformOrigin="0.5,0.5">
                            <Canvas.RenderTransform>
                                <ScaleTransform x:Name="RingScale" ScaleX="0.3" ScaleY="0.3"/>
                            </Canvas.RenderTransform>
                            <Ellipse Canvas.Left="14" Canvas.Top="14" Width="258" Height="258" Stroke="#28FFFFFF" StrokeThickness="1"/>
                            <Ellipse Canvas.Left="25" Canvas.Top="25" Width="236" Height="236" Stroke="#4418A8E8" StrokeThickness="1.4" StrokeDashArray="3 7"/>
                            <Path Canvas.Left="20" Canvas.Top="20" Width="246" Height="246" Stroke="#B8D4AF37" StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Data>
                                    <PathGeometry><PathFigure StartPoint="123,1" IsClosed="False"><ArcSegment Size="122,122" SweepDirection="Clockwise" IsLargeArc="False" Point="242,88"/></PathFigure></PathGeometry>
                                </Path.Data>
                            </Path>
                        </Canvas>

                        <Canvas x:Name="OrbitClockwise" Width="310" Height="310" RenderTransformOrigin="0.5,0.5">
                            <Canvas.RenderTransform><RotateTransform x:Name="ClockwiseRotation" Angle="0" CenterX="155" CenterY="155"/></Canvas.RenderTransform>
                            <Ellipse Canvas.Left="33" Canvas.Top="33" Width="244" Height="244" Stroke="#2418A8E8" StrokeThickness="1" StrokeDashArray="1 10"/>
                            <Ellipse Canvas.Left="151" Canvas.Top="27" Width="6" Height="6" Fill="#E018A8E8"><Ellipse.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.8" Color="#18A8E8"/></Ellipse.Effect></Ellipse>
                            <Ellipse Canvas.Left="267" Canvas.Top="152" Width="4" Height="4" Fill="#D4AF37"/>
                        </Canvas>

                        <Canvas x:Name="OrbitCounterClockwise" Width="300" Height="300" RenderTransformOrigin="0.5,0.5">
                            <Canvas.RenderTransform><RotateTransform x:Name="CounterClockwiseRotation" Angle="0" CenterX="150" CenterY="150"/></Canvas.RenderTransform>
                            <Path Canvas.Left="34" Canvas.Top="34" Width="232" Height="232" Stroke="#4CD4AF37" StrokeThickness="1.4" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Data><PathGeometry><PathFigure StartPoint="116,1" IsClosed="False"><ArcSegment Size="115,115" SweepDirection="Counterclockwise" IsLargeArc="False" Point="210,51"/></PathFigure></PathGeometry></Path.Data>
                            </Path>
                            <Ellipse Canvas.Left="44" Canvas.Top="205" Width="5" Height="5" Fill="#D4AF37"/>
                        </Canvas>

                        <Border x:Name="LogoContainer" Width="192" Height="192" CornerRadius="96" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Opacity="0">
                            <Border.RenderTransform><ScaleTransform x:Name="LogoScale" ScaleX="0.88" ScaleY="0.88"/></Border.RenderTransform>
                            <Border.Effect><DropShadowEffect x:Name="LogoGlow" BlurRadius="28" ShadowDepth="0" Opacity="0.38" Color="#18A8E8"/></Border.Effect>
                            <Image Source="pack://application:,,,/Assets/KnouxOfficialLogo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{DynamicResource AppTitle}" HorizontalAlignment="Center" FontFamily="{DynamicResource FontDisplay}" FontWeight="SemiBold" FontSize="31" Foreground="{DynamicResource TextMainBrush}"/>
                    <TextBlock Grid.Row="3" Text="{DynamicResource AppSubtitle}" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.9"/>

                    <StackPanel Grid.Row="5" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusBeacon" Width="7" Height="7" Fill="{DynamicResource CyanBrush}" Margin="0,0,10,0"><Ellipse.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.7" Color="#18A8E8"/></Ellipse.Effect></Ellipse>
                        <TextBlock x:Name="StatusText" Text="{DynamicResource SplashInitializing}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
