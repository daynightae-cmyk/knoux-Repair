<UserControl x:Class="KnouxRepair.Views.AllToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KnouxRepair.ViewModels"
             xmlns:views="clr-namespace:KnouxRepair.Views" Background="Transparent">
    <UserControl.Resources>
        <vm:AllToolsViewModel x:Key="VM"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="CardActionButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8" Padding="11,7" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                    <Grid><TextBlock Text="&#xE721;" FontFamily="{DynamicResource FontIcon}" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMainBrush}" FontSize="12" Padding="23,0,0,0" CaretBrush="{DynamicResource CyanBrush}" ToolTip="Search name, Arabic name, purpose, ID, or category" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" TextChanged="SearchBox_TextChanged"/></Grid>
                </Border>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextMainBrush}" FontSize="12" Padding="8,5" BorderThickness="1" BorderBrush="{DynamicResource InputBorderBrush}"/>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilteredTools}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="{DynamicResource CardFillColorDefaultBrush}" BorderBrush="{Binding CategoryAccentBrush}" BorderThickness="1" CornerRadius="10" Width="278" MinHeight="250" Margin="0,0,12,12" Padding="14" Cursor="Hand" MouseLeftButtonDown="ToolCard_Click">
                            <Border.Style><Style TargetType="Border"><Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CardFillColorHoverBrush}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
                                <DataTrigger Binding="{Binding ExecutionState}" Value="Running"><Setter Property="BorderThickness" Value="2"/></DataTrigger>
                            </Style.Triggers></Style></Border.Style>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding CategoryIcon}" FontFamily="{DynamicResource FontIcon}" Foreground="{Binding CategoryAccentBrush}" FontSize="18" Margin="0,0,7,0"/><TextBlock Text="{Binding CategoryDisplayName}" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource GlassSurfaceActiveBrush}" BorderBrush="{DynamicResource GlassBorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="5,2"><TextBlock Text="{Binding RiskDisplayName}" Foreground="{Binding CategoryAccentBrush}" FontSize="8.5" FontWeight="SemiBold"/></Border>
                                </Grid>
                                <TextBlock Grid.Row="2" Text="{Binding DisplayName}" Foreground="{DynamicResource TextMainBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38"/>
                                <TextBlock Grid.Row="4" Text="{Binding Purpose}" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="35"/>
                                <ItemsControl Grid.Row="6" ItemsSource="{Binding Capability.CapabilityChips}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource BrushSurface}" CornerRadius="3" Padding="4,2" Margin="0,0,4,4"><TextBlock Text="{Binding}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=DataContext.CategoryAccentBrush}" FontSize="8" FontWeight="SemiBold"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <StackPanel Grid.Row="8" Orientation="Horizontal" VerticalAlignment="Bottom"><ItemsControl ItemsSource="{Binding Capability.Actions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding}" Click="ToolActionButton_Click" Style="{StaticResource CardActionButton}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                                <Grid Grid.Row="8" VerticalAlignment="Bottom" Margin="0,30,0,0" IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ExecutionSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="8.5"/><TextBlock Grid.Column="1" Text="{Binding ToolId}" Foreground="{DynamicResource BrushMuted}" FontFamily="{DynamicResource FontMono}" FontSize="8.5"/></Grid>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="4,0,0,8" Style="{DynamicResource CaptionTextBlockStyle}"><Run Text="{Binding TotalFiltered, Mode=OneWay}"/><Run Text=" tools"/></TextBlock>
        </Grid>
        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="Transparent"/><views:ToolDetailPanel x:Name="DetailPanel" Grid.Column="2"/>
    </Grid>
</UserControl>
