<UserControl x:Class="KnouxRepair.Views.AllToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KnouxRepair.ViewModels"
             xmlns:views="clr-namespace:KnouxRepair.Views"
             xmlns:controls="clr-namespace:KnouxRepair.Controls"
             Background="Transparent">
    <UserControl.Resources>
        <vm:AllToolsViewModel x:Key="VM"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- Tool Grid -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search + Filter bar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource InputBgBrush}"
                        CornerRadius="6" Padding="10,6"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="{DynamicResource FontIcon}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBox Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextMainBrush}"
                                 FontSize="12" Padding="20,0,0,0"
                                 CaretBrush="{DynamicResource CyanBrush}"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          Background="{DynamicResource InputBgBrush}"
                          Foreground="{DynamicResource TextMainBrush}"
                          FontSize="12" Padding="8,5"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource InputBorderBrush}"/>
            </Grid>

            <!-- Tool Cards with Virtualization -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredTools}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ToolCard Tool="{Binding}"
                                               PrimaryActionCommand="{Binding DataContext.ExecuteToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               SecondaryActionCommand="{Binding DataContext.PreviewToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Margin="0,0,10,10"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Count -->
            <TextBlock Grid.Row="2" VerticalAlignment="Bottom"
                       HorizontalAlignment="Left" Margin="4,0,0,8"
                       Style="{DynamicResource CaptionTextBlockStyle}">
                <Run Text="{Binding TotalFiltered, Mode=OneWay}"/>
                <Run Text=" tools"/>
            </TextBlock>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="1"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent"/>

        <!-- Detail Panel -->
        <views:ToolDetailPanel x:Name="DetailPanel" Grid.Column="2"
                               Margin="0,0,0,0"/>
    </Grid>
</UserControl>
