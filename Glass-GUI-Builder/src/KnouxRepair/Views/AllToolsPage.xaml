<UserControl x:Class="KnouxRepair.Views.AllToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KnouxRepair.ViewModels"
             xmlns:views="clr-namespace:KnouxRepair.Views"
             Background="Transparent">
    <UserControl.Resources>
        <vm:AllToolsViewModel x:Key="VM"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- Tool Grid -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search + Filter bar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource InputBgBrush}"
                        CornerRadius="6" Padding="10,6"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="{DynamicResource FontIcon}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBox Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextMainBrush}"
                                 FontSize="12" Padding="20,0,0,0"
                                 CaretBrush="{DynamicResource CyanBrush}"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          Background="{DynamicResource InputBgBrush}"
                          Foreground="{DynamicResource TextMainBrush}"
                          FontSize="12" Padding="8,5"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource InputBorderBrush}"/>
            </Grid>

            <!-- Tool Cards -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredTools}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Background="{DynamicResource CardFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeDefaultBrush}"
                                    BorderThickness="1" CornerRadius="10"
                                    Width="200" Margin="0,0,10,10"
                                    Padding="14,12" Cursor="Hand"
                                    MouseLeftButtonDown="ToolCard_Click"
                                    Tag="{Binding}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                                      Opacity="0.1" Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding ToolId}"
                                                   Foreground="{DynamicResource BrushCyan}"
                                                   FontSize="10" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Border Background="{DynamicResource BrushSurface}"
                                                    CornerRadius="3" Padding="4,1" Margin="0,0,4,0"
                                                    Visibility="{Binding RequiresAdmin,
                                                        Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{DynamicResource ToolAdmin}"
                                                           Foreground="{DynamicResource BrushAmber}"
                                                           FontSize="8" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding EnglishName}"
                                               Foreground="{DynamicResource TextMainBrush}"
                                               FontSize="12.5" FontWeight="SemiBold"
                                               Margin="0,6,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Purpose}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="10.5" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="30"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Count -->
            <TextBlock Grid.Row="2" VerticalAlignment="Bottom"
                       HorizontalAlignment="Left" Margin="4,0,0,8"
                       Style="{DynamicResource CaptionTextBlockStyle}">
                <Run Text="{Binding TotalFiltered, Mode=OneWay}"/>
                <Run Text=" tools"/>
            </TextBlock>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="1"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent"/>

        <!-- Detail Panel -->
        <views:ToolDetailPanel x:Name="DetailPanel" Grid.Column="2"
                               Margin="0,0,0,0"/>
    </Grid>
</UserControl>
