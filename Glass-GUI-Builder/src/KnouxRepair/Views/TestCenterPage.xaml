<UserControl x:Class="KnouxRepair.Views.TestCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="0,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource NavTestCenter}"
                       Style="{DynamicResource TitleTextBlockStyle}"/>
            <TextBlock Text="{DynamicResource TestCenterSubtitle}"
                       Style="{DynamicResource CaptionTextBlockStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Summary bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource TestCenterLastRun}" 
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="LastRunText"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextMainBrush}"
                               FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TotalText"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextMainBrush}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock Grid.Column="2" x:Name="PassedText" Foreground="{DynamicResource BrushGreen}"
                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock Grid.Column="3" x:Name="FailedText" Foreground="{DynamicResource BrushRed}"
                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BtnRunTests" Content="{DynamicResource ActionRunTests}"
                    Style="{DynamicResource AccentButton}"
                    Click="BtnRunTests_Click"/>
        </StackPanel>

        <DataGrid x:Name="TestsGrid" Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  Background="{DynamicResource BrushBg2}"
                  Foreground="{DynamicResource BrushTextMain}"
                  BorderBrush="{DynamicResource BrushBorder}"
                  BorderThickness="1"
                  RowBackground="{DynamicResource BrushBg2}"
                  AlternatingRowBackground="{DynamicResource BrushBg3}"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  FontSize="12">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource BrushBg3}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource TestCenterColName}" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource TestCenterColStatus}" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="{DynamicResource TestCenterColDetail}" Binding="{Binding Detail}" Width="300"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>