<UserControl x:Class="KnouxRepair.Views.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KnouxRepair.ViewModels"
             Background="Transparent">
    <UserControl.Resources>
        <vm:ReportsViewModel x:Key="VM"/>
    </UserControl.Resources>
    <Grid Margin="0,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource NavReports}"
                       Style="{DynamicResource TitleTextBlockStyle}"/>
            <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Margin="0,4,0,0">
                <Run Text="{Binding TotalReports, Mode=OneWay}"/>
                <Run Text="{DynamicResource SearchResults}"/>
            </TextBlock>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BtnOpenReportFolder"
                    Content="{DynamicResource ActionOpenReportFolder}"
                    Style="{DynamicResource GlassButton}"
                    Margin="0,0,8,0"
                    Click="BtnOpenReportFolder_Click" IsEnabled="False"/>
            <Button x:Name="BtnOpenReportsRoot"
                    Content="{DynamicResource ActionOpenReports}"
                    Style="{DynamicResource GlassButton}"
                    Click="BtnOpenReportsRoot_Click"/>
        </StackPanel>

        <DataGrid x:Name="ReportsGrid" Grid.Row="3"
                  ItemsSource="{Binding Reports}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="{DynamicResource BrushBg2}"
                  Foreground="{DynamicResource BrushTextMain}"
                  BorderBrush="{DynamicResource BrushBorder}"
                  BorderThickness="1"
                  RowBackground="{DynamicResource BrushBg2}"
                  AlternatingRowBackground="{DynamicResource BrushBg3}"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  FontSize="12"
                  SelectionChanged="ReportsGrid_SelectionChanged">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource BrushBg3}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource QuarantineColTool}" Binding="{Binding ToolId}" Width="70"/>
                <DataGridTextColumn Header="{DynamicResource BackupsColTool}" Binding="{Binding ToolName}" Width="200"/>
                <DataGridTextColumn Header="{DynamicResource QuarantineColType}" Binding="{Binding Category}" Width="140"/>
                <DataGridTextColumn Header="{DynamicResource ToolRisk}" Binding="{Binding RiskLevel}" Width="100"/>
                <DataGridTextColumn Header="{DynamicResource TestCenterColStatus}" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="{DynamicResource ReportsColItems}" Binding="{Binding ItemsFound}" Width="60"/>
                <DataGridTextColumn Header="{DynamicResource ReportsColStarted}" Binding="{Binding StartedAt}" Width="140"/>
                <DataGridTextColumn Header="{DynamicResource BackupsColPath}" Binding="{Binding FolderName}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Detail panel -->
        <Border Grid.Row="5" Background="{DynamicResource CardFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="DetailHeader" Text="{DynamicResource ReportsSelectHint}"
                           Style="{DynamicResource CaptionTextBlockStyle}"/>
                <TextBlock x:Name="DetailBody"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           FontSize="11.5" Foreground="{DynamicResource TextMainBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>