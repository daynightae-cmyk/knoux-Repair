<UserControl x:Class="KnouxRepair.Views.BackupsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="0,0,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource NavBackups}"
                       Style="{DynamicResource TitleTextBlockStyle}"/>
            <TextBlock Text="{DynamicResource BackupsSubtitle}"
                       Style="{DynamicResource CaptionTextBlockStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{DynamicResource ActionRefresh}"
                    Style="{DynamicResource GlassButton}"
                    Click="BtnRefresh_Click"/>
            <Button Content="{DynamicResource ActionOpenFolder}"
                    x:Name="BtnOpenFolder"
                    Style="{DynamicResource GlassButton}"
                    Margin="8,0,0,0"
                    Click="BtnOpenFolder_Click" IsEnabled="False"/>
        </StackPanel>

        <DataGrid x:Name="BackupsGrid" Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  Background="{DynamicResource BrushBg2}"
                  Foreground="{DynamicResource BrushTextMain}"
                  BorderBrush="{DynamicResource BrushBorder}"
                  BorderThickness="1"
                  RowBackground="{DynamicResource BrushBg2}"
                  AlternatingRowBackground="{DynamicResource BrushBg3}"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  FontSize="12"
                  SelectionChanged="BackupsGrid_SelectionChanged">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource BrushBg3}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource BackupsColTool}" Binding="{Binding ToolId}" Width="110"/>
                <DataGridTextColumn Header="{DynamicResource BackupsColStamp}" Binding="{Binding FolderName}" Width="160"/>
                <DataGridTextColumn Header="{DynamicResource BackupsColSize}" Binding="{Binding SizeBytes}" Width="110"/>
                <DataGridTextColumn Header="{DynamicResource BackupsColFiles}" Binding="{Binding ItemCount}" Width="80"/>
                <DataGridTextColumn Header="{DynamicResource BackupsColPath}" Binding="{Binding BackupPath}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>